{
	"name": "overlord-vn-server",
	"version": "1.0.0",
	"main": "app.js",
	"scripts": {
		"start": "node app.js",
		"dev": "nodemon app.js",
		"test": "jest --coverage --detectOpenHandles --forceExit",
		"create": "npx sequelize-cli db:create",
		"migrate": "npx sequelize-cli db:migrate",
		"undo": "npx sequelize-cli db:migrate:undo:all",
		"seed": "npx sequelize-cli db:seed:all"
	},
	"dependencies": {
		"@google/generative-ai": "^0.24.0",
		"bcryptjs": "^3.0.2",
		"cors": "^2.8.5",
		"dotenv": "^16.4.7",
		"express": "^4.21.2",
		"google-auth-library": "^9.15.1",
		"jest": "^29.7.0",
		"jsonwebtoken": "^9.0.2",
		"multer": "^1.4.5-lts.2",
		"overlord-vn-server": "file:",
		"pg": "^8.14.1",
		"sequelize": "^6.37.6",
		"sequelize-cli": "^6.6.2",
		"supertest": "^7.1.0"
	},
	"devDependencies": {
		"nodemon": "^3.0.1"
	},
	"jest": {
		"testEnvironment": "node",
		"coveragePathIgnorePatterns": [
			"/node_modules/",
			"/coverage/"
		],
		"collectCoverage": true,
		"collectCoverageFrom": [
			"**/*.js",
			"!**/node_modules/**",
			"!**/coverage/**"
		],
		"coverageReporters": [
			"lcov",
			"text",
			"text-summary"
		],
		"coverageThreshold": {
			"global": {
				"branches": 90,
				"functions": 90,
				"lines": 90,
				"statements": 90
			}
		}
	}
}
